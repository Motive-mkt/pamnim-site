{
  "entities": {
    "Profile": {
      "title": "User Profile",
      "description": "Stores user roles and basic information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string", "enum": ["owner", "senior_designer", "designer", "project_manager", "client"] }
      },
      "required": ["uid", "email", "role"]
    },
    "Project": {
      "title": "Client Project",
      "description": "Represents an interior design project.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "clientId": { "type": "string" },
        "employeeIds": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["active", "completed", "on-hold"] },
        "phases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "status": { "type": "string", "enum": ["pending", "active", "complete"] },
              "description": { "type": "string" },
              "date": { "type": "string" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "clientId"]
    },
    "ProgressNote": {
      "title": "Progress Note",
      "description": "Updates shared between team and client.",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["text", "authorId"]
    },
    "SiteContent": {
      "title": "Site Content",
      "description": "CMS data for the homepage.",
      "type": "object",
      "properties": {
        "hero": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "subheadline": { "type": "string" },
            "highlightWord": { "type": "string" }
          }
        },
        "contact": {
          "type": "object",
          "properties": {
            "phone": { "type": "string" },
            "whatsapp": { "type": "string" },
            "email": { "type": "string" },
            "address": { "type": "string" }
          }
        },
        "services": { "type": "array" },
        "portfolio": { "type": "array" }
      }
    },
    "MediaItem": {
      "title": "Media Item",
      "description": "An image item for the gallery or portfolio.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "category": { "type": "string" },
        "image": { "type": "string", "format": "uri" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "category", "image"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "A customer message or qualified lead from the contact form.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "projectType": { "type": "string" },
        "message": { "type": "string" },
        "leadTag": { "type": "string", "enum": ["high-value", "incomplete", "general"] },
        "budget": { "type": "string" },
        "timeline": { "type": "string" },
        "scope": { "type": "string" },
        "status": { "type": "string", "enum": ["new", "read", "responded"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "message"]
    },
    "DetailedService": {
      "title": "Detailed Service",
      "description": "Information about a sub-service, including hero and gallery images.",
      "type": "object",
      "properties": {
        "slug": { "type": "string" },
        "categoryId": { "type": "string" },
        "name": { "type": "string" },
        "desc": { "type": "string" },
        "heroImage": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["slug", "categoryId", "name", "desc"]
    },
    "Review": {
      "title": "Customer Review",
      "description": "Reviews and ratings submitted by clients.",
      "type": "object",
      "properties": {
        "projectId": { "type": "string" },
        "projectName": { "type": "string" },
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "rating": { "type": "number", "minimum": 1, "maximum": 5 },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "clientId", "rating"]
    },
    "AttendanceRecord": {
      "title": "Attendance Record",
      "description": "Daily worker attendance record for pay run and calendar.",
      "type": "object",
      "properties": {
        "workerId": { "type": "string" },
        "workerName": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["present_full", "present_half", "absent", "approved_leave", "holiday"] },
        "dayValue": { "type": "number", "minimum": 0, "maximum": 1 },
        "dailyRate": { "type": "number" },
        "accruedAmount": { "type": "number" },
        "weekIdentifier": { "type": "string" },
        "projectId": { "type": "string" },
        "loggedBy": { "type": "string" },
        "loggedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["workerId", "date", "status", "dayValue", "dailyRate", "accruedAmount", "weekIdentifier"]
    },
    "LeaveRequest": {
      "title": "Leave Request",
      "description": "Worker submitted leave request.",
      "type": "object",
      "properties": {
        "workerId": { "type": "string" },
        "workerName": { "type": "string" },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "type": { "type": "string", "enum": ["sick", "casual", "emergency"] },
        "reason": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "ownerNote": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["workerId", "startDate", "endDate", "type", "reason", "status"]
    },
    "ExtraPaymentRequest": {
      "title": "Extra Payment Request",
      "description": "Worker extra payment or overtime/reimbursement request.",
      "type": "object",
      "properties": {
        "workerId": { "type": "string" },
        "workerName": { "type": "string" },
        "amount": { "type": "number", "minimum": 1 },
        "projectId": { "type": "string" },
        "projectName": { "type": "string" },
        "reason": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "ownerNote": { "type": "string" },
        "weekIdentifier": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["workerId", "amount", "reason", "status"]
    },
    "HRMSSettings": {
      "title": "HRMS Settings",
      "description": "Custom site holidays, closure days, and HRMS configurations.",
      "type": "object",
      "properties": {
        "customHolidays": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "profiles": {
      "schema": "Profile",
      "description": "User profile records."
    },
    "projects": {
      "schema": "Project",
      "description": "Interior design projects."
    },
    "projects/{projectId}/progressNotes": {
      "schema": "ProgressNote",
      "description": "Chronological updates for a project."
    },
    "siteContent": {
      "schema": "SiteContent",
      "description": "CMS configurations."
    },
    "gallery": {
      "schema": "MediaItem",
      "description": "Home page gallery images."
    },
    "portfolio_assets": {
      "schema": "MediaItem",
      "description": "Full portfolio assets collection."
    },
    "inquiries": {
      "schema": "Inquiry",
      "description": "Customer contact form submissions."
    },
    "detailedServices": {
      "schema": "DetailedService",
      "description": "CMS content for the 12 dynamic sub-services."
    },
    "reviews": {
      "schema": "Review",
      "description": "Client project feedback and star ratings."
    },
    "attendanceRecords": {
      "schema": "AttendanceRecord",
      "description": "Daily site worker attendance records."
    },
    "leaveRequests": {
      "schema": "LeaveRequest",
      "description": "Site worker leave requests."
    },
    "extraPaymentRequests": {
      "schema": "ExtraPaymentRequest",
      "description": "Site worker overtime and extra pay requests."
    },
    "hrmsSettings": {
      "schema": "HRMSSettings",
      "description": "HRMS holidays and site closure configurations."
    }
  }
}
