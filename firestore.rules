rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() { return request.auth != null; }
    
    function getProfile(uid) {
      return get(/databases/$(database)/documents/profiles/$(uid)).data;
    }
    
    function isOwnerProfile() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'owner';
    }
    
    function isElevatedEmployee() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'elevated_employee';
    }

    function isOwner() {
      return isOwnerProfile();
    }

    function isStaff() {
      return isSignedIn() && exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) && (
        'role' in getProfile(request.auth.uid) && (
          getProfile(request.auth.uid).role in ['owner', 'elevated_employee', 'regular_employee', 'senior_designer', 'designer', 'project_manager']
        )
      );
    }

    function canManageUsers() {
      return isOwner() || isElevatedEmployee();
    }

    function isClient() {
      return isSignedIn() && exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) && getProfile(request.auth.uid).role == 'client';
    }

    // Validation Helpers
    function isValidMediaItem(data) {
      return data.keys().hasAll(['title', 'category', 'image', 'createdAt']) &&
             data.title is string &&
             data.category is string &&
             data.image is string &&
             data.createdAt is string;
    }

    function isValidInquiry(data) {
      return data.keys().hasAll(['name', 'email', 'message', 'status', 'createdAt']) &&
             data.name is string && data.name.size() <= 200 &&
             data.email is string && data.email.size() <= 200 &&
             data.message is string && data.message.size() <= 5000 &&
             data.status in ['new', 'read', 'responded'] &&
             data.createdAt is string && data.createdAt.size() <= 100;
    }

    // Profiles
    match /profiles/{userId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if canManageUsers() || (isSignedIn() && request.auth.uid == userId);
      allow delete: if canManageUsers() || (isSignedIn() && request.auth.uid == userId);
    }

    // Pending Signups
    match /pending_signups/{signupId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if canManageUsers() || isSignedIn();
    }

    // Projects & Subcollections
    match /projects/{projectId} {
      allow read: if isStaff() || (isClient() && resource.data.clientId == request.auth.uid);
      allow create: if canManageUsers() || isStaff();
      allow update: if isStaff();
      allow delete: if isOwner();
      
      match /updates/{updateId} {
        allow read: if isStaff() || (isClient() && get(/databases/$(database)/documents/projects/$(projectId)).data.clientId == request.auth.uid);
        allow create, update, delete: if isStaff();
      }

      match /progressNotes/{noteId} {
        allow read: if isStaff() || (isClient() && get(/databases/$(database)/documents/projects/$(projectId)).data.clientId == request.auth.uid);
        allow create, update, delete: if isStaff();
      }
    }

    // Chats / Messages
    match /chats/{clientId} {
      allow read, write: if isSignedIn();
      
      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    // Site Content
    match /siteContent/{docId} {
      allow read: if true;
      allow write: if isStaff() || isOwner() || (docId == 'metadata' && !exists(/databases/$(database)/documents/siteContent/metadata));
    }

    // Media Collections (Gallery & Portfolio)
    match /gallery/{itemId} {
      allow read: if true;
      allow create, update, delete: if isStaff() || isOwner();
    }

    match /portfolio_assets/{itemId} {
      allow read: if true;
      allow create, update, delete: if isStaff() || isOwner();
    }

    // Inquiries
    match /inquiries/{inquiryId} {
      allow create: if isValidInquiry(request.resource.data);
      allow read, update, delete: if isStaff() || isOwner();
    }
    
    // Detailed Services
    match /detailedServices/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isStaff() || isOwner();
    }
    
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
