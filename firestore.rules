rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function getProfile(uid) {
      return get(/databases/$(database)/documents/profiles/$(uid)).data;
    }
    
    function isOwner() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) && 
             getProfile(request.auth.uid).role == 'owner' &&
             getProfile(request.auth.uid).status != 'pending';
    }
    
    function isElevatedEmployee() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) && 
             getProfile(request.auth.uid).role == 'elevated_employee' &&
             getProfile(request.auth.uid).status != 'pending';
    }

    function canManageUsers() {
      return isOwner() || isElevatedEmployee();
    }

    function isStaff() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) && 
             getProfile(request.auth.uid).status != 'pending' &&
             getProfile(request.auth.uid).role in ['owner', 'elevated_employee', 'regular_employee', 'senior_designer', 'designer', 'project_manager'];
    }

    function isClient() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) && 
             getProfile(request.auth.uid).role == 'client';
    }

    function isWorker() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) && 
             getProfile(request.auth.uid).role == 'worker';
    }

    // Validation Helpers
    function isValidMediaItem(data) {
      return data.keys().hasAll(['title', 'category', 'image', 'createdAt']) &&
             data.title is string &&
             data.category is string &&
             data.image is string &&
             data.createdAt is string;
    }

    function isValidInquiry(data) {
      return data.keys().hasAll(['name', 'email', 'message', 'status', 'createdAt']) &&
             data.name is string && data.name.size() <= 200 &&
             data.email is string && data.email.size() <= 200 &&
             data.message is string && data.message.size() <= 5000 &&
             data.status in ['new', 'read', 'responded', 'replied'] &&
             data.createdAt is string && data.createdAt.size() <= 100;
    }

    // Profiles
    // 1. A user can never write role or status on their own profiles/{uid} doc (only an existing owner/elevated_employee can set those fields)
    // 2. A user can only read/write their own profile, except owner/elevated_employee/staff who can read any
    match /profiles/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        isStaff() ||
        canManageUsers()
      );

      allow create: if isSignedIn() && (
        canManageUsers() ||
        (
          request.auth.uid == userId &&
          (request.resource.data.role == 'pending' || request.resource.data.role == 'worker') &&
          request.resource.data.status == 'pending'
        ) ||
        (
          request.auth.uid == userId &&
          request.resource.data.role == 'owner' &&
          !exists(/databases/$(database)/documents/siteContent/metadata)
        )
      );

      allow update: if isSignedIn() && (
        canManageUsers() ||
        (
          request.auth.uid == userId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.status == resource.data.status
        )
      );

      allow delete: if isOwner();
    }

    // Pending Signups
    // pending_signups is writable by anyone creating their own doc with pending status, but only readable/manageable by owner/elevated_employee
    match /pending_signups/{signupId} {
      allow read: if canManageUsers();
      allow create: if isSignedIn() && request.auth.uid == signupId && (
        request.resource.data.role == 'pending' || 
        request.resource.data.role == 'worker' ||
        request.resource.data.status == 'pending'
      );
      allow update, delete: if canManageUsers();
    }

    // Projects & Subcollections
    // Clients can only read projects where they're the clientId, never write to projects directly
    match /projects/{projectId} {
      allow read: if isStaff() || (
        isSignedIn() && 
        resource.data.clientId == request.auth.uid
      );
      allow create, update, delete: if isStaff();
      
      match /updates/{updateId} {
        allow read: if isStaff() || (
          isSignedIn() && 
          get(/databases/$(database)/documents/projects/$(projectId)).data.clientId == request.auth.uid
        );
        allow create, update, delete: if isStaff();
      }

      match /progressNotes/{noteId} {
        allow read: if isStaff() || (
          isSignedIn() && 
          get(/databases/$(database)/documents/projects/$(projectId)).data.clientId == request.auth.uid
        );
        allow create, update, delete: if isStaff();
      }

      match /payments/{paymentId} {
        allow read: if isStaff() || (
          isSignedIn() && 
          get(/databases/$(database)/documents/projects/$(projectId)).data.clientId == request.auth.uid
        );
        allow create, update, delete: if isStaff();
      }

      match /expenses/{expenseId} {
        allow read: if isStaff();
        allow create, update, delete: if isStaff();
      }
    }

    // Chats / Messages
    // Client can only read/send to their own thread; staff can access all; owner only can delete thread/messages
    match /chats/{clientId} {
      allow read: if isStaff() || (isSignedIn() && request.auth.uid == clientId);
      allow create, update: if isStaff() || (isSignedIn() && request.auth.uid == clientId);
      allow delete: if isOwner();
      
      match /messages/{messageId} {
        allow read: if isStaff() || (isSignedIn() && request.auth.uid == clientId);
        allow create: if (isStaff() || (isSignedIn() && request.auth.uid == clientId)) && request.resource.data.senderUid == request.auth.uid;
        allow update: if isStaff();
        allow delete: if isOwner();
      }
    }

    // Site Content
    match /siteContent/{docId} {
      allow read: if true;
      allow write: if isStaff() || (docId == 'metadata' && !exists(/databases/$(database)/documents/siteContent/metadata));
    }

    // Media Collections (Gallery & Portfolio)
    match /gallery/{itemId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    match /portfolio_assets/{itemId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    // Inquiries
    match /inquiries/{inquiryId} {
      allow create: if isValidInquiry(request.resource.data);
      allow read, update, delete: if isStaff();
    }
    
    // Services & Materials Catalog (Owner / Staff access only)
    match /servicesMaterials/{itemId} {
      allow read, write: if isStaff();
    }

    // Invoices & Quotes Archives (Owner / Staff access only)
    match /invoices/{invoiceId} {
      allow read, write: if isStaff();
      match /paymentReceipts/{receiptId} {
        allow read, write: if isStaff();
      }
    }
    match /{path=**}/paymentReceipts/{receiptId} {
      allow read, write: if isStaff();
    }
    match /{path=**}/expenses/{expenseId} {
      allow read, write: if isStaff();
    }

    match /quotes/{quoteId} {
      allow read, write: if isStaff();
    }

    // Leads / Manual Customers (Staff / Owner only)
    match /leads/{leadId} {
      allow read, write: if isStaff();
    }

    // HRMS (Workers, Daily Attendance, Work Logs, Wage Payments, Leave & Extra Requests)
    match /workers/{workerId} {
      allow read: if isStaff() || (
        isSignedIn() && (request.auth.uid == workerId || resource.data.userId == request.auth.uid)
      );
      allow write: if isStaff();
    }
    match /workLogs/{logId} {
      allow read: if isStaff() || (
        isSignedIn() && resource.data.workerId == request.auth.uid
      );
      allow write: if isStaff();
    }
    match /attendanceRecords/{recordId} {
      allow read: if isStaff() || (
        isSignedIn() && resource.data.workerId == request.auth.uid
      );
      allow write: if isStaff();
    }
    match /workerPayments/{paymentId} {
      allow read: if isStaff() || (
        isSignedIn() && resource.data.workerId == request.auth.uid
      );
      allow write: if isStaff();
    }
    match /leaveRequests/{requestId} {
      allow read: if isStaff() || (
        isSignedIn() && resource.data.workerId == request.auth.uid
      );
      allow create: if isSignedIn() && 
                    request.resource.data.workerId == request.auth.uid &&
                    request.resource.data.status == 'pending';
      allow update, delete: if isStaff();
    }
    match /extraPaymentRequests/{requestId} {
      allow read: if isStaff() || (
        isSignedIn() && resource.data.workerId == request.auth.uid
      );
      allow create: if isSignedIn() && 
                    request.resource.data.workerId == request.auth.uid &&
                    request.resource.data.status == 'pending';
      allow update, delete: if isStaff();
    }
    match /hrmsSettings/{docId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }
    
    // Detailed Services
    match /detailedServices/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    // Reviews (Public read for testimonials, client create or validated public submission, staff manage)
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if (
        (isSignedIn() && request.resource.data.clientId == request.auth.uid) ||
        (
          request.resource.data.clientName is string &&
          request.resource.data.clientName.size() > 0 &&
          request.resource.data.clientName.size() <= 200 &&
          request.resource.data.comment is string &&
          request.resource.data.comment.size() > 0 &&
          request.resource.data.comment.size() <= 5000 &&
          request.resource.data.rating is number &&
          request.resource.data.rating >= 1 &&
          request.resource.data.rating <= 5
        )
      );
      allow update, delete: if isStaff();
    }
    
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
